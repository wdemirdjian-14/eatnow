# Configuration de l'API Eatnow — à copier dans /etc/eatnow/api.env
#
#   sudo mkdir -p /etc/eatnow
#   sudo cp deploy/api.env.example /etc/eatnow/api.env
#   sudo chmod 600 /etc/eatnow/api.env && sudo chown www-data /etc/eatnow/api.env
#
# Ce fichier contient un secret : il ne doit jamais être versionné.

# Port d'écoute local. nginx y relaie /api.
#
# 3001 est volontairement évité : il est souvent déjà pris par une autre
# application Node. Si vous changez cette valeur, relancez setup-server.sh
# pour que le vhost nginx pointe au même endroit.
PORT=3011
HOST=127.0.0.1

# Compte administrateur, créé au tout premier démarrage si aucun
# administrateur n'existe encore en base.
#
# ⚠️ Ce fichier d'exemple est versionné dans un dépôt public : n'y inscrivez
# jamais le vrai mot de passe. Renseignez-le uniquement dans la copie
# /etc/eatnow/api.env, qui n'est pas versionnée.
#
# Tant que EATNOW_ADMIN_PASSWORD est vide, aucun compte n'est créé — c'est
# volontaire : mieux vaut pas d'administrateur qu'un mot de passe prévisible.
EATNOW_ADMIN_LOGIN=warren
EATNOW_ADMIN_PASSWORD=

# Durée de validité d'une session, en jours.
EATNOW_SESSION_DAYS=30

# Laisser à `true` : le cookie de session n'est alors transmis qu'en HTTPS.
EATNOW_SECURE_COOKIES=true

# ------------------------------------------------------------------
# Envoi d'e-mails (identifiants transmis aux restaurateurs)
# ------------------------------------------------------------------
#
# Entièrement optionnel : sans EATNOW_SMTP_HOST, la console d'administration
# affiche le mot de passe à transmettre de vive voix et propose un brouillon
# d'e-mail pré-rempli. Rien n'est jamais envoyé en silence.
#
# ⚠️ Comme pour le mot de passe administrateur : ce fichier d'exemple est
# versionné dans un dépôt public. N'inscrivez le mot de passe de la boîte que
# dans /etc/eatnow/api.env.
#
# Chez Ionos : smtp.ionos.fr, port 465 (TLS implicite), authentification
# requise. Le port 465 active automatiquement le chiffrement ; le port 587
# passerait par STARTTLS.
EATNOW_SMTP_HOST=
EATNOW_SMTP_PORT=465
EATNOW_SMTP_USER=
EATNOW_SMTP_PASS=
EATNOW_SMTP_FROM=Eatnow <no-reply@eatnow.walautao.fr>

# Adresse publique, reprise dans le lien de connexion des e-mails.
EATNOW_APP_URL=https://eatnow.walautao.fr
