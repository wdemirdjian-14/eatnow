{
  "name": "eatnow",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Eatnow — trouvez les restaurants autour de vous, avec leur carte traduite dans votre langue.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/gen-sw.mjs && node scripts/version-json.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "tsc --noEmit -p tsconfig.app.json",
    "logo": "node scripts/gen-logo.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "export:seed": "tsx scripts/export-seed.mjs"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
