{
  "name": "eatnow-server",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "API Eatnow — authentification, cartes, traductions, achats de langues.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
